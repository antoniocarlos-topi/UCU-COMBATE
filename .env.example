# ==============================================================================
# U.C.U ARENA — Configuração de Ambiente para Desenvolvimento Local
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase.
# Nunca compartilhe ou envie ao Git chaves com permissões de administrador (service_role).

# URL do seu projeto Supabase (Configurações do Projeto > API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública (anon key) com permissões restritas via RLS
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Ambiente
VITE_APP_ENV=development
